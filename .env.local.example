# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Verify Service SID — enable the SMS and RCS channels on this service in the
# Twilio Console (Verify > Services). RCS also requires an approved RCS sender.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito
AWS_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Proof token — shared HMAC secret between this app and the
# VerifyAuthChallengeResponse Lambda. Use a random string of 32+ chars.
VERIFY_PROOF_SECRET=your_random_secret_at_least_32_chars

# AWS Secrets Manager (production only)
# USE_SECRETS_MANAGER=true
