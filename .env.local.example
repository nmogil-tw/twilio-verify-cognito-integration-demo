# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Verify Service SID — enable the SMS channel on this service in the Twilio
# Console (Verify > Services). RCS is delivered automatically via Verify's RCS
# Upgrade on the SMS channel (an approved RCS sender enables branded delivery).
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito
COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS region + credentials. APP_-prefixed on purpose so a shell AWS_PROFILE /
# AWS_REGION (e.g. an SSO profile) can't override which account the app uses.
APP_AWS_REGION=eu-west-2
# Local dev only: named CLI profile for AWS creds. Omit in production
# (App Runner) to use the instance role via the default provider chain.
APP_AWS_PROFILE=your_cli_profile_name

# Proof token — shared HMAC secret between this app and the
# VerifyAuthChallengeResponse Lambda. Use a random string of 32+ chars.
VERIFY_PROOF_SECRET=your_random_secret_at_least_32_chars

# AWS Secrets Manager (production only)
# USE_SECRETS_MANAGER=true
